js {
  const {
    englishLanguageFilter
  } = require("/includes/language_filters.js");
}

config {
  type: "incremental",
  database: dataform.projectConfig.vars.staging_project,
  schema: dataform.projectConfig.vars.staging_dataset,
  name: "user_feedback_unioned",
  description: "Staging layer: normalizes, unpivots, and unions raw SmartSurvey and Support API data, including unanswered/skipped prompts.",
  uniqueKey: ["response_identifier"], 
  bigquery: {
    partitionBy: "DATE(created)",
    partitionExpirationDays: Number(dataform.projectConfig.vars.partitionExpirationDays),
    requirePartitionFilter: true,
    updatePartitionFilter: (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
      ? "created >= CAST('" + dataform.projectConfig.vars.backfill_start_date + "' AS DATETIME) AND T.created < CAST('" + dataform.projectConfig.vars.backfill_end_date + "' AS DATETIME)"
      : "created >= CAST(DATE_SUB(CURRENT_DATE('Europe/London'), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY) AS DATETIME)"
  }
}

WITH smart_survey_parsed AS (
  SELECT * EXCEPT(batch_processed_ts)
  FROM ${ref("smart_survey_responses")}
  WHERE 
  response_identifier IS NOT NULL
  AND source IS NOT NULL
  AND feedback_record_id IS NOT NULL
  AND created IS NOT NULL
  AND prompt_value IS NOT NULL
  AND
    ${
      (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
        ? "created >= CAST('" + dataform.projectConfig.vars.backfill_start_date + "' AS DATETIME) AND created < CAST('" + dataform.projectConfig.vars.backfill_end_date + "' AS DATETIME)"
        : (incremental() ? "created >= CAST(DATE_SUB(CURRENT_DATE('Europe/London'), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY) AS DATETIME)" : "TRUE")
    }
),

support_api_parsed AS (
  SELECT * EXCEPT(batch_processed_ts)
  FROM ${ref("support_api_anonymous_contacts")}
  WHERE
  response_identifier IS NOT NULL
  AND source IS NOT NULL
  AND feedback_record_id IS NOT NULL
  AND created IS NOT NULL
  AND prompt_value IS NOT NULL
  AND 
    ${
      (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
        ? "created >= CAST('" + dataform.projectConfig.vars.backfill_start_date + "' AS DATETIME) AND created < CAST('" + dataform.projectConfig.vars.backfill_end_date + "' AS DATETIME)"
        : (incremental() ? "created >= CAST(DATE_SUB(CURRENT_DATE('Europe/London'), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY) AS DATETIME)" : "TRUE")
    }
),

unioned_sources AS (
  SELECT * FROM smart_survey_parsed
  UNION ALL
  SELECT * FROM support_api_parsed
)

SELECT 
  *,
    CASE 
    WHEN ${englishLanguageFilter("response_value_raw")} THEN 'eng'
    ELSE 'non-eng'
  END AS response_language,
  CURRENT_TIMESTAMP() AS batch_processed_ts
FROM unioned_sources
WHERE TRUE


/*  Deduplicate within the window to guarantee MERGE uniqueness */
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY response_identifier 
  ORDER BY created DESC
) = 1