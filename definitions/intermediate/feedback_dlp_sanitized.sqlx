config {
  type: "incremental",
  database: dataform.projectConfig.vars.staging_project,
  schema: dataform.projectConfig.vars.staging_dataset,
  name: "feedback_dlp_sanitized",
  description: "Isolates the high-risk Cloud DLP de-identification step to optimize API batching and costs.",
  uniqueKey: ["response_identifier"],
  bigquery: {
    partitionBy: "DATE(created)",
    partitionExpirationDays: Number(dataform.projectConfig.vars.partitionExpirationDays),
    
    updatePartitionFilter: (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
      ? "created >= '" + dataform.projectConfig.vars.backfill_start_date + "' AND T.created < '" + dataform.projectConfig.vars.backfill_end_date + "'"
      : "created >= DATETIME_SUB(CURRENT_DATETIME(), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY)"
  }
}

WITH base_records AS (
  SELECT
    raw.response_identifier,
    raw.feedback_record_id,
    raw.created,
    -- Truncate and censor profanities locally before hitting remote DLP API
    ${ref("censor_profanity")}(TRIM(SUBSTR(raw.response_value_raw, 1, 2200))) AS clean_raw_value
  FROM
    ${ref("user_feedback_unioned")} AS raw

  -- Anti-join against self ONLY in incremental mode (prevents missing table crash on first run)
  ${
    incremental()
      ? "LEFT JOIN " + self() + " AS target ON raw.response_identifier = target.response_identifier AND " + (
          (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
            ? "target.created >= '" + dataform.projectConfig.vars.backfill_start_date + "' AND target.created < '" + dataform.projectConfig.vars.backfill_end_date + "'"
            : "DATE(target.created) >= DATE_SUB(CURRENT_DATE(), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY)"
        )
      : ""
  }

  WHERE
    raw.response_type = 'text'
    AND NULLIF(TRIM(raw.response_value_raw), '') IS NOT NULL

    -- Date interval toggle and anti-join check
    ${
      (dataform.projectConfig.vars.backfill_start_date && dataform.projectConfig.vars.backfill_end_date)
        ? "AND raw.created >= '" + dataform.projectConfig.vars.backfill_start_date + "' AND raw.created < '" + dataform.projectConfig.vars.backfill_end_date + "'" + (incremental() ? " AND target.response_identifier IS NULL" : "")
        : (incremental()
            ? "AND DATE(raw.created) >= DATE_SUB(CURRENT_DATE(), INTERVAL " + dataform.projectConfig.vars.incremental_load_date_interval + " DAY) AND target.response_identifier IS NULL"
            : "AND DATE(raw.created) >= DATE_SUB(CURRENT_DATE(), INTERVAL " + dataform.projectConfig.vars.historic_load_date_interval + " DAY)")
    }

  -- Guarantee single row per response_identifier to prevent MERGE failure
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY raw.response_identifier 
    ORDER BY raw.created DESC
  ) = 1
)

SELECT
  response_identifier,
  feedback_record_id,
  created,
  -- Remote DLP call only if text is non-empty
  CASE 
    WHEN NULLIF(TRIM(clean_raw_value), '') IS NOT NULL THEN
      `${dataform.projectConfig.vars.dlp_project}.${dataform.projectConfig.vars.dlp_dataset}.dlp_deidentify_text`(clean_raw_value)
    ELSE 
      clean_raw_value
  END AS dlp_cleaned_value,
  
  -- Audit timestamp tracking when this batch was executed
  CURRENT_TIMESTAMP() AS batch_processed_ts
FROM
  base_records