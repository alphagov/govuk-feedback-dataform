config {
  type: "operations",
  tags: ["feedback_enrichment"]
}



-- Step 1: Query Gemini and merge the outputs back to the original table
MERGE `govuk-user-feedback-dev.ml_test.user_feedback_core_ml_poc` T
USING (
  WITH raw_records AS (
    SELECT
      response_identifier,
      response_value AS text,
      created
    FROM
      `govuk-user-feedback-dev.ml_test.user_feedback_core_ml_poc`
    WHERE
      response_type = 'text'
      AND created>"2025-01-01"
      -- Incremental filtering: only pull new records
      --${when(incremental(), `AND created > (SELECT MAX(created) FROM ${self()})` )}
      AND feedback_record_id in (
'308963931',
'309178036',
'309190868',
'309177767'
)
      -- Cost Optimization: Avoid calling Gemini again for rows that already have predictions
      AND (sentiment IS NULL OR spam_classification IS NULL OR spam_probability IS NULL)
      
  ),

  -- Table-Valued Function (TVF) to query BQML
  gemini_predictions AS (
    SELECT
      response_identifier,
      created,
      result AS gemini_raw
    FROM
      AI.GENERATE_TEXT(
        -- Forces local processing strictly within the europe-west2 (London) datacenter
        MODEL `govuk-user-feedback-dev.ml_test.feedback_bq_ml_gemini_model_london`,
        (
          SELECT
            response_identifier,
            created,
            CONCAT(
              "You are an expert analyst in British English and UK cultural nuances, specialized in analyzing public sector feedback for GOV.UK.\n",
              "Analyze the following user feedback and determine its British sentiment, its UK-specific spam classification, and calculate the probability of it being spam.\n\n",
              
              "RULES FOR BRITISH SENTIMENT ANALYSIS:\n",
              "1. Decode British Understatement: British users often use polite, understated language to express deep frustration. Phrases like 'a bit disappointed', 'not ideal', 'could be better', or 'with respect' should be treated as NEGATIVE.\n",
              "2. Identify Sarcasm & British Slang: Understand terms like 'brilliant' or 'perfect' when used sarcastically. Phrases like 'not bad' or 'quite good' are typically POSITIVE or NEUTRAL depending on the context.\n",
              "3. Accommodate British Spelling: Understand and process British variations (e.g., 'colour', 'organise', 'programme', 'queue').\n\n",
              
              "RULES FOR BRITISH SPAM CLASSIFICATION:\n",
              "1. Classify as 'spam' if it contains commercial ads, external promotional links, automated SEO text, or UK-focused scams (e.g., fake HMRC refund claims, PPI recovery offers, lottery wins, or offshore gambling ads).\n",
              "2. Classify as 'not spam' if it is a genuine user attempting to communicate about UK public services (e.g., NHS, DVLA, Council Tax, Universal Credit, HM Passport Office, visas).\n",
              "3. DO NOT flag anger as spam: Feedback containing angry British slang (e.g., calling a system 'rubbish', 'daft', 'shambles', or 'a joke') is NOT spam; it is highly NEGATIVE not spam.\n\n",
              
              "Feedback to analyze: ", text
            ) AS prompt
          FROM
            raw_records
        ),
        STRUCT(
          '''{
            "generation_config": {
              "temperature": 0.1,
              "response_mime_type": "application/json",
              "response_schema": {
                "type": "OBJECT",
                "properties": {
                  "sentiment": { 
                    "type": "STRING", 
                    "description": "Must be exactly: POSITIVE, NEGATIVE, or NEUTRAL"
                  },
                  "spam_classification": { 
                    "type": "STRING", 
                    "description": "Must be exactly: spam or not spam" 
                  },
                  "spam_probability": { 
                    "type": "NUMBER", 
                    "description": "Floating-point probability between 0.0 and 1.0 indicating how likely the text is to be spam"
                  }
                },
                "required": ["sentiment", "spam_classification", "spam_probability"]
              }
            }
          }''' AS model_params
        )
      )
  )

  SELECT
    response_identifier,
    created,
    JSON_VALUE(gemini_raw, '$.sentiment') AS sentiment,
    JSON_VALUE(gemini_raw, '$.spam_classification') AS spam_classification,
    CAST(JSON_VALUE(gemini_raw, '$.spam_probability') AS FLOAT64) AS spam_probability
  FROM
    gemini_predictions
) S
ON T.response_identifier = S.response_identifier
   AND T.created = S.created
   AND T.created >"2025-01-01"
WHEN MATCHED THEN
  UPDATE SET
    T.sentiment = S.sentiment,
    T.spam_classification = S.spam_classification,
    T.spam_probability = S.spam_probability